ENABLE_ML_INTENT_DETECTION=true
ENABLE_RULE_BASED_INTENT_DETECTION=true
ENABLE_ML_MODEL_HINT_ROUTING=true
ML_CONFIDENCE_THRESHOLD=0.50
ROUTER_YAML_CONFIG=configs/latency-first.yaml

# ML Router type from llmrouter-lib: knn, svm, graph, or mf
ML_ROUTER_TYPE=svm

# API Keys for LLM Providers (set the ones you have)
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# DB Configuration — single connection string (postgres://user:password@host:port/dbname)
ROUTER_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/llm_router

# Force offline mode for HuggingFace Hub (no downloads)
# HF_HUB_OFFLINE=1

# Logging
IGNIS_LOG_FILE=logs/ignis_router.log
IGNIS_LOG_CONSOLE=false
